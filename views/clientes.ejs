<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Clientes | Pediatria</title>
        <style>
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: #f4f7fb;
                color: #192b43;
                font:
                    15px Arial,
                    sans-serif;
            }
            header {
                background: #fff;
                border-bottom: 1px solid #e4eaf1;
                padding: 16px max(calc((100% - 1080px) / 2), 24px);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .brand {
                font-weight: 700;
                color: #175c72;
                font-size: 18px;
            }
            nav {
                display: flex;
                gap: 20px;
                align-items: center;
            }
            a {
                color: #24677d;
                text-decoration: none;
            }
            a:hover {
                text-decoration: underline;
            }
            button {
                border: 0;
                background: none;
                color: #24677d;
                cursor: pointer;
                font-size: 15px;
            }
            .wrap {
                max-width: 1080px;
                margin: 40px auto;
                padding: 0 24px;
            }
            .top {
                display: flex;
                align-items: end;
                justify-content: space-between;
                margin-bottom: 24px;
            }
            h1 {
                margin: 0 0 6px;
                font-size: 30px;
            }
            .muted {
                color: #728197;
                margin: 0;
            }
            .panel {
                background: #fff;
                border: 1px solid #e5eaf0;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 5px 20px #18304708;
            }
            .tools {
                display: flex;
                gap: 12px;
                margin-bottom: 20px;
            }
            .field {
                padding: 11px 12px;
                border: 1px solid #d5dee8;
                border-radius: 7px;
                font-size: 15px;
            }
            .tools input {
                flex: 1;
            }
            .primary {
                display: inline-block;
                border-radius: 7px;
                background: #147a83;
                color: #fff;
                padding: 11px 16px;
                font-weight: 600;
            }
            .primary:hover {
                background: #10656d;
                text-decoration: none;
            }
            .table-wrap {
                overflow: auto;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 740px;
            }
            th,
            td {
                text-align: left;
                padding: 14px 12px;
                border-bottom: 1px solid #edf0f4;
            }
            th {
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #728197;
            }
            .actions {
                display: flex;
                gap: 12px;
                align-items: center;
            }
            .danger {
                color: #a53b3b;
            }
            .empty {
                text-align: center;
                color: #728197;
                padding: 28px;
            }
            .alert {
                background: #eaf6f0;
                border: 1px solid #c9e9d8;
                color: #256143;
                padding: 12px;
                border-radius: 8px;
                margin-bottom: 16px;
            }
            .group {
                display: inline-block;
                border-radius: 20px;
                background: #eaf4f5;
                padding: 5px 10px;
                color: #216a72;
            }
        </style>
    </head>
    <body>
        <header>
            <div class="brand">Pediatria · Gestão de clientes</div>
            <nav>
                <a href="/clientes"><strong>Clientes</strong></a
                ><a href="/grupos">Grupos</a><span><%= usuario.nome %></span>
                <form action="/logout" method="post">
                    <button type="submit">Sair</button>
                </form>
            </nav>
        </header>
        <main class="wrap">
            <div class="top">
                <div>
                    <h1>Clientes</h1>
                    <p class="muted">
                        Consulte os cadastros e seus grupos de atendimento.
                    </p>
                </div>
                <a class="primary" href="/clientes/novo">+ Novo cliente</a>
            </div>
            <% if (mensagem) { %>
            <div class="alert"><%= mensagem.replaceAll('+', ' ') %></div>
            <% } %>
            <section class="panel">
                <form class="tools" action="/clientes" method="get">
                    <input
                        class="field"
                        type="search"
                        name="busca"
                        value="<%= busca %>"
                        placeholder="Buscar por nome, CPF, e-mail, telefone ou grupo"
                    /><button class="primary" type="submit">Buscar</button
                    ><% if (busca) { %><a class="field" href="/clientes"
                        >Limpar</a
                    ><% } %>
                </form>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>CPF</th>
                                <th>Contato</th>
                                <th>Grupo</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!clientes.length) { %>
                            <tr>
                                <td colspan="5" class="empty">
                                    Nenhum cliente encontrado.
                                </td>
                            </tr>
                            <% } %>
                            <% clientes.forEach(cliente => { %>
                            <tr>
                                <td>
                                    <strong><%= cliente.nome %></strong>
                                </td>
                                <td><%= cliente.cpf %></td>
                                <td>
                                    <%= cliente.email %><br /><span
                                        class="muted"
                                        ><%= cliente.telefone %></span
                                    >
                                </td>
                                <td>
                                    <span class="group"
                                        ><%= cliente.nome_grupo || 'Sem grupo'
                                        %></span
                                    >
                                </td>
                                <td>
                                    <div class="actions">
                                        <a
                                            href="/clientes/editar/<%= cliente.id %>"
                                            >Editar</a
                                        >
                                        <form
                                            action="/clientes/deletar/<%= cliente.id %>"
                                            method="post"
                                            onsubmit="
                                                return confirm(
                                                    'Excluir este cliente?'
                                                );
                                            "
                                        >
                                            <button
                                                class="danger"
                                                type="submit"
                                            >
                                                Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </body>
</html>
